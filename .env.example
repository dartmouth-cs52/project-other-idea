# Copy into apps/web/.env.local. Everything is optional for local development:
# without keys the API serves a built-in dev site (key pk_dev_local) and you
# can run the mock model.

# Model: mock | gemini-3.5-flash-lite | gemini-3.8-flash | claude-haiku-5-5 | claude-sonnet-5-5
HAPTIC_MODEL=mock
# Optional override: MINIMAL | LOW | MEDIUM | HIGH
# HAPTIC_THINKING_LEVEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Voice: hold the launcher to talk, answers spoken back. Switched off for now
# because recognition wasn't good enough. Set HAPTIC_VOICE=on to try it again.
# HAPTIC_VOICE=on
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Signs SDK session tokens. Required in production: openssl rand -base64 32
HAPTIC_SESSION_SECRET=

# Built-in development site, used when Supabase isn't configured.
HAPTIC_DEV_KEY=pk_dev_local
HAPTIC_DEV_ORIGINS=http://localhost:4100,http://localhost:3000
# HAPTIC_DEV_NOTES=Short description of the app for the model.

# Supabase (accounts, sites, learned site map)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app, used in snippets and docs.
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
