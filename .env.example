# Copy to .env. Never commit .env.

# Any Claude model ID, or "mock" to run with no key (a keyword matcher, for testing the plumbing).
# claude-haiku-5-5 is the faster, cheaper choice once quality is checked on your site.
HAPTIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Where the server is reachable from customers' browsers. Goes into the script tag.
HAPTIC_PUBLIC_URL=http://localhost:4000
PORT=4000
