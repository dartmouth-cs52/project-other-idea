{
  "name": "haptic",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "start": "tsx --env-file-if-exists=.env src/server/index.ts",
    "tag": "tsx --env-file-if-exists=.env src/intake/cli.ts",
    "build": "tsx src/widget/build.ts",
    "deploy": "wrangler deploy",
    "site:publish": "tsx --env-file-if-exists=.env src/intake/publish.ts",
    "site:off": "tsx src/intake/switch.ts off",
    "site:on": "tsx src/intake/switch.ts on",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "tsx --test --test-concurrency=1 test/browser/*.test.ts",
    "test:dashboard": "tsx --test --test-concurrency=1 test/browser/dashboard.test.ts",
    "eval": "tsx --env-file-if-exists=.env eval/run.ts",
    "eval:record": "tsx eval/record.ts",
    "eval:look": "tsx eval/look.ts",
    "eval:guides": "tsx --env-file-if-exists=.env eval/drive.ts",
    "eval:import": "tsx eval/import.ts",
    "test:widget": "tsx --test --test-concurrency=1 test/widget/*.test.ts",
    "eval:toolkits": "tsx eval/toolkits/run.ts",
    "eval:acts": "tsx eval/acts.ts",
    "eval:sweep": "tsx eval/sweep/run.ts",
    "eval:answers": "tsx --env-file-if-exists=.env eval/answers-run.ts",
    "eval:answers:record": "tsx eval/answers-record.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@neondatabase/serverless": "^1.2.1",
    "cheerio": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "date-fns": "^4.4.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.162.0"
  }
}
