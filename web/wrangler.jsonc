{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "haptic-web",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.ts",
  // The static site that `next build` writes to out/.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Where contact form requests are kept.
  "kv_namespaces": [{ "binding": "ACCESS_REQUESTS", "id": "90e7d35b139e4720ac435d792e9b4280" }],
  // The preview address on workers.dev stays on. It is marked so search engines skip it.
  "workers_dev": true,
  // The live site. The Worker sends www to the bare domain.
  "routes": [
    { "pattern": "joinhaptic.com", "custom_domain": true },
    { "pattern": "www.joinhaptic.com", "custom_domain": true }
  ]
}
